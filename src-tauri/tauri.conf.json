{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Arrumo AI Video Editor",
  "identifier": "pt.aidevs.arrumo",
  "version": "0.1.0",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "Arrumo AI Video Editor", "width": 1280, "height": 800, "minWidth": 480, "minHeight": 420, "backgroundColor": "#2337b4" }
    ],
    "security": {
      "csp": "default-src 'self'; frame-src arrumo-panel: http://arrumo-panel.localhost; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data: http://127.0.0.1:*; media-src http://127.0.0.1:*"
    }
  },
  "plugins": {
    "deep-link": { "desktop": { "schemes": ["arrumo"] } },
    "updater": {
      "pubkey": "",
      "endpoints": ["https://github.com/aidevs-pt/arrumo-video-editor/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"],
    "publisher": "DEVS.AI UNIPESSOAL LDA",
    "copyright": "© 2026 DEVS.AI UNIPESSOAL LDA. Licensed under the GNU AGPL v3.",
    "category": "Video",
    "homepage": "https://www.aidevs.pt/tools/arrumo",
    "shortDescription": "AI video editor where an agent edits and you approve every step.",
    "longDescription": "Describe the video or add your footage. An AI agent writes the script, designs on-brand animations, voices, cuts and renders it, and waits for your approval at each step.",
    "linux": {
      "deb": { "depends": ["gstreamer1.0-plugins-good", "gstreamer1.0-libav"] },
      "rpm": {
        "depends": ["gstreamer1-plugins-good"],
        "recommends": ["gstreamer1-plugin-libav", "gstreamer1-plugin-openh264"]
      },
      "appimage": { "bundleMediaFramework": true }
    },
    "windows": {
      "nsis": { "languages": ["English", "Spanish", "Portuguese"] },
      "wix": { "upgradeCode": "ed28b0b3-fe7c-4c1b-b432-477d3fd62d90" }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "dmg": {
        "background": "dmg/background.png",
        "windowSize": { "width": 660, "height": 400 },
        "appPosition": { "x": 180, "y": 170 },
        "applicationFolderPosition": { "x": 480, "y": 170 }
      }
    }
  }
}
