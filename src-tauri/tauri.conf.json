{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Arrumo Video Editor",
  "identifier": "pt.aidevs.arrumo",
  "version": "0.1.0",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "Arrumo Video Editor", "width": 1120, "height": 760, "minWidth": 480, "minHeight": 420 }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
