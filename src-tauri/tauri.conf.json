{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Arrumo Video Editor",
  "identifier": "pt.aidevs.arrumo",
  "version": "0.1.0",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "Arrumo Video Editor", "width": 1280, "height": 800, "minWidth": 480, "minHeight": 420 }
    ],
    "security": {
      "csp": "default-src 'self'; frame-src arrumo-panel: http://arrumo-panel.localhost; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data: http://127.0.0.1:*; media-src http://127.0.0.1:*"
    }
  },
  "plugins": { "deep-link": { "desktop": { "schemes": ["arrumo"] } } },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"],
    "linux": {
      "deb": { "depends": ["ffmpeg", "gstreamer1.0-plugins-good", "gstreamer1.0-libav"] },
      "rpm": {
        "depends": ["/usr/bin/ffmpeg", "/usr/bin/ffprobe", "gstreamer1-plugins-good"],
        "recommends": ["gstreamer1-plugin-libav", "gstreamer1-plugin-openh264"]
      },
      "appimage": { "bundleMediaFramework": true }
    }
  }
}
